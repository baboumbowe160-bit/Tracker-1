rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function me(uid) { return request.auth != null && request.auth.uid == uid; }
    function confirmed(uid) { return me(uid) && request.auth.token.email_verified == true; }
    match /users/{uid}/records/{id} {
      allow read, delete: if me(uid);
      allow create, update: if confirmed(uid) && id.size() <= 200
        && request.resource.data.keys().hasOnly(['c', 'k', 'd', 'del', 'at'])
        && request.resource.data.c in ['sales', 'agents', 'referrals', 'walletComm', 'evc', 'capital', 'errors', 'expenses', 'daily', 'recon', 'meta'];
    }
    match /users/{uid}/devices/{id} {
      allow read, delete: if me(uid);
      allow create, update: if confirmed(uid) && id.size() <= 100
        && request.resource.data.keys().hasOnly(['name', 'first', 'last', 'revoked']);
    }
  }
}
